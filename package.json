{
	"name": "l3-nest-starter-service",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"start": "nest start --port 3000",
		"start:dev": "nest start --watch --port 3000",
		"start:debug": "nest start --debug --watch --port 3000",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"docker-build": "docker build -t l3-nest-starter-service .",
		"docker-run": "docker run --detach --publish 8080:3000 --name l3-nest-starter-service l3-nest-starter-service",
		"docker-stop": "docker stop l3-nest-starter-service",
		"lint:fix": "eslint --fix",
		"prettier": "npx prettier . --write",
		"prepare": "husky install"
	},
	"lint-staged": {
		"src/**/*.{ts,js}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"dependencies": {
		"@nestjs/common": "^11.0.10",
		"@nestjs/core": "^11.0.10",
		"@nestjs/platform-express": "^11.0.10",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.4",
		"@nestjs/schematics": "^11.0.1",
		"@nestjs/testing": "^11.0.10",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.13.5",
		"@types/supertest": "^6.0.2",
		"@typescript-eslint/eslint-plugin": "^8.24.1",
		"@typescript-eslint/parser": "^8.24.1",
		"@commitlint/cli": "^19.7.1",
		"@commitlint/config-conventional": "^19.7.1",
		"eslint": "^9.19.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.1.4",
		"husky": "^8.0.0",
		"lint-staged": "^15.4.3",
		"jest": "^29.7.0",
		"prettier": "3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.6",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3",
		"typescript-eslint": "^8.22.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
